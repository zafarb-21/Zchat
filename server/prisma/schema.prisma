generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  passwordHash     String
  recoveryCodeHash String?
  createdAt        DateTime @default(now())

  publicKeyJwk Json?
  keyUpdatedAt DateTime?
  lastSeenAt   DateTime @default(now())

  devices          UserDevice[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  messageEnvelopes MessageEnvelope[]
}

model Conversation {
  id        String   @id @default(cuid())
  convKey   String   @unique
  userA     String
  userB     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             String       @id
  convId         String
  conv           Conversation @relation(fields: [convId], references: [id])

  fromUser       String
  fromDeviceId   String
  toUser         String
  bodyCiphertext String
  ts             DateTime @default(now())

  deliveredAt DateTime?
  readAt      DateTime?

  sender   User @relation("SentMessages", fields: [fromUser], references: [username])
  receiver User @relation("ReceivedMessages", fields: [toUser], references: [username])
  envelopes MessageEnvelope[]

  @@index([toUser, deliveredAt])
  @@index([convId, ts])
}

model UserDevice {
  id                   String   @id @default(cuid())
  userUsername         String
  user                 User     @relation(fields: [userUsername], references: [username])
  deviceId             String   @unique
  deviceLabel          String
  publicKeyJwk         Json?
  notificationsEnabled Boolean  @default(false)
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  messageEnvelopes MessageEnvelope[]

  @@index([userUsername, lastSeenAt])
}

model MessageEnvelope {
  id            String     @id @default(cuid())
  msgId         String
  message       Message    @relation(fields: [msgId], references: [id], onDelete: Cascade)
  ownerUsername String
  owner         User       @relation(fields: [ownerUsername], references: [username])
  deviceId      String
  device        UserDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  bodyCiphertext String
  deliveredAt   DateTime?
  createdAt     DateTime   @default(now())

  @@unique([msgId, deviceId])
  @@index([ownerUsername, deviceId])
  @@index([deviceId, deliveredAt])
}

model PeerSession {
  id          String   @id @default(cuid())
  peerKey     String   @unique
  userA       String
  userB       String
  requestedBy String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  endedAt     DateTime?

  @@index([userA, status])
  @@index([userB, status])
}
