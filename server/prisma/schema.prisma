generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  passwordHash     String
  recoveryCodeHash String?
  createdAt        DateTime @default(now())

  publicKeyJwk Json?
  keyUpdatedAt DateTime?
  lastSeenAt   DateTime @default(now())

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Conversation {
  id        String   @id @default(cuid())
  convKey   String   @unique
  userA     String
  userB     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             String       @id
  convId         String
  conv           Conversation @relation(fields: [convId], references: [id])

  fromUser       String
  toUser         String
  bodyCiphertext String
  ts             DateTime @default(now())

  deliveredAt DateTime?
  readAt      DateTime?

  sender   User @relation("SentMessages", fields: [fromUser], references: [username])
  receiver User @relation("ReceivedMessages", fields: [toUser], references: [username])

  @@index([toUser, deliveredAt])
  @@index([convId, ts])
}

model PeerSession {
  id          String   @id @default(cuid())
  peerKey     String   @unique
  userA       String
  userB       String
  requestedBy String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  endedAt     DateTime?

  @@index([userA, status])
  @@index([userB, status])
}
